# ==============================================================================
# Cloud Production Environment Configuration for free-claude-code-proxy
# ==============================================================================

# Server Network Settings
PORT=8080
HOST=0.0.0.0
FAST_PREFIX_DETECTION=true
ENABLE_NETWORK_PROBE_MOCK=true
ENABLE_TITLE_GENERATION_SKIP=true

# Authentication Token
ANTHROPIC_AUTH_TOKEN=freecc
ANTHROPIC_API_KEY=freecc

# High-Speed SWE Model Fleet
MODEL=groq/openai/gpt-oss-120b
MODEL_SONNET=groq/qwen/qwen3.8-27b
MODEL_OPUS=groq/qwen/qwen3.6-27b
MODEL_HAIKU=groq/qwen/qwen3.8-27b
MODEL_FABLE=open_router/minimax/minimax-m3:free
MODEL_FALLBACKS=groq/qwen/qwen3.8-27b,groq/qwen/qwen3.6-27b,groq/openai/gpt-oss-120b,open_router/minimax/minimax-m3:free

# Cloud Provider API Credentials (Set in Render / Koyeb Environment Variables)
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
